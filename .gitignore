# Per-run screenshot + handoff artifacts.
# HANDOFF.md files ARE committed so cloud routines can read them.
# PNG/JPG screenshots are local-only (heavy + cloud can't view them anyway).
.screenshots/**/*.png
.screenshots/**/*.jpg
.screenshots/**/*.jpeg

# Screen recordings are local-only — heavy, and a single one can exceed
# GitHub's 100MB push limit (this is what blocked a push). Never commit them.
*.mov
*.mp4
.claude/worktrees/

# Per-developer / per-worktree Claude Code permission overrides.
# Written by noum-orchestrator into each agent worktree so teammates auto-approve
# safe ops; must stay out of git so it doesn't pollute review diffs.
.claude/settings.local.json
.arena-key
*.env.local
.env.local
tools/coach-arena/.env
tools/coach-arena/.env.local

# Noum Stop-gate runtime state (per-session, opt-in)
.claude/stop_gate_enabled
.claude/stop_gate_base

# local Anthropic key for live arena runs (never commit; rotate after use)
.noum_anthropic_key

# Firebase CLI local hosting/deploy cache.
.firebase/
