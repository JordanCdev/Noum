rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Assumed social data model:
    // - profiles_public/{uid}: bounded display name plus server-authored
    //   competitive aggregates. Callable reads only; clients cannot get/list.
    // - leagues/{bucket}/members/{uid}: the same non-PII aggregate shape,
    //   callable reads only; clients cannot get/list.
    // - challenges/{uuid}: immutable participant metadata and prompt only.
    // - challenges/{uuid}/submissions/{uid}: that participant's private result.
    // - challenges/{uuid}/combined/result: materialized only after both private
    //   submissions exist; both participants may then read the combined result.
    // - underscore-prefixed social collections: callable/runtime-only evidence,
    //   replay, rate-limit, relationship, cutover, tombstone, and exact-
    //   deletion reference state.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(accountID) {
      return isAuthenticated() && request.auth.uid == accountID;
    }

    function deletionPending(accountID) {
      return exists(
        /databases/$(database)/documents/_accountDeletionState/$(accountID)
      );
    }

    function isWritableOwner(accountID) {
      return isOwner(accountID) && !deletionPending(accountID);
    }

    function validDisplayName(value) {
      return value is string && value.size() > 0 && value.size() <= 60;
    }

    function validBoundedString(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function validSpeakingContext(value) {
      return value in ['work', 'interviews', 'presentations', 'social'];
    }

    function validCoachingPriority(value) {
      return value in [
        'reduceFillers', 'moreConcise', 'thinkFaster', 'calmerDelivery'
      ];
    }

    function validConfidenceLevel(value) {
      return value in ['beginner', 'rebuilding', 'inconsistent', 'confident'];
    }

    function validSpeakingChallenge(value) {
      return value in ['fillerWords', 'rambling', 'freezing', 'rushing'];
    }

    function validSpeakingOutcome(value) {
      return value in ['concise', 'composed', 'persuasive', 'spontaneous'];
    }

    function validSpeakingStyleGoal(value) {
      return value in [
        'authoritative', 'warm', 'concise', 'persuasive',
        'executive', 'storytelling'
      ];
    }

    function validPrivateUserRoot(data, accountID) {
      return data.keys().hasOnly(['accountID', 'provider', 'updatedAt'])
             && data.keys().hasAll(['accountID', 'provider', 'updatedAt'])
             && data.accountID == accountID
             && data.provider in ['guest', 'apple', 'google']
             && data.updatedAt is number
             && data.updatedAt >= 0;
    }

    function validPrivateProfile(data) {
      return data.keys().hasOnly([
               'speakingContext', 'primaryGoal', 'confidenceLevel',
               'biggestChallenge', 'customChallengeText', 'desiredOutcome',
               'speakingStyleGoal', 'chosenStyleGoal', 'styleReference',
               'coachingBrief', 'motivationWhyNow', 'successVision',
               'paraphrasedGoal', 'bigMomentID', 'secondaryStyleGoal'
             ])
             && data.keys().hasAll([
               'speakingContext', 'primaryGoal', 'confidenceLevel',
               'biggestChallenge', 'desiredOutcome', 'speakingStyleGoal',
               'chosenStyleGoal', 'styleReference', 'coachingBrief',
               'motivationWhyNow', 'successVision'
             ])
             && validSpeakingContext(data.speakingContext)
             && validCoachingPriority(data.primaryGoal)
             && validConfidenceLevel(data.confidenceLevel)
             && validSpeakingChallenge(data.biggestChallenge)
             && (!('customChallengeText' in data)
                 || data.customChallengeText == null
                 || validBoundedString(data.customChallengeText, 90))
             && validSpeakingOutcome(data.desiredOutcome)
             && validSpeakingStyleGoal(data.speakingStyleGoal)
             && (data.chosenStyleGoal == null
                 || validSpeakingStyleGoal(data.chosenStyleGoal))
             && validBoundedString(data.styleReference, 500)
             && validBoundedString(data.coachingBrief, 2000)
             && validBoundedString(data.motivationWhyNow, 1000)
             && validBoundedString(data.successVision, 1000)
             && (!('paraphrasedGoal' in data)
                 || data.paraphrasedGoal == null
                 || validBoundedString(data.paraphrasedGoal, 220))
             && (!('bigMomentID' in data)
                 || data.bigMomentID == null
                 || (data.bigMomentID is string
                     && data.bigMomentID.matches(
                       '^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$'
                     )))
             && (!('secondaryStyleGoal' in data)
                 || data.secondaryStyleGoal == null
                 || validSpeakingStyleGoal(data.secondaryStyleGoal));
    }

    function validPrivateProgress(data) {
      return data.keys().hasOnly(['xp'])
             && data.keys().hasAll(['xp'])
             && data.xp is int
             && data.xp >= 0
             && data.xp <= 1000000000;
    }

    function validPrivateSession(data, sessionID) {
      return sessionID.matches(
               '^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$'
             )
             && data.keys().hasOnly([
               'id', 'transcript', 'fillerWordCount', 'duration', 'date',
               'mode', 'imConversationDetails', 'score', 'xpEarned',
               'headline', 'insights', 'coachSummary', 'aiCoachFeedback',
               'prompt', 'theme', 'drillResult', 'transcriptConfidence',
               'transcriptionProvider', 'pressureLevel', 'isRated',
               'pauseMetrics', 'pitchMetrics', 'grammarFindings',
               'intentFocus', 'intentLabel', 'vocalEnergyMetrics',
               'repEventLocations', 'isEvaluationFixture', 'fixtureID'
             ])
             && data.keys().hasAll([
               'id', 'transcript', 'fillerWordCount', 'duration', 'date',
               'mode', 'insights', 'pressureLevel', 'isRated',
               'isEvaluationFixture'
             ])
             && data.id == sessionID
             && validBoundedString(data.transcript, 100000)
             && data.fillerWordCount is int
             && data.fillerWordCount >= 0
             && data.fillerWordCount <= 100000
             && data.duration is number
             && data.duration >= 0
             && data.duration <= 14400
             && data.date is number
             && data.date >= 1577836800
             && validBoundedString(data.mode, 64)
             && data.insights is list
             && data.insights.size() <= 32
             && validBoundedString(data.pressureLevel, 64)
             && data.isRated is bool
             && data.isEvaluationFixture == false;
    }

    function validPublicProfile(data, accountID) {
      return data.keys().hasOnly([
               'accountID', 'displayName',
               'rating', 'peakRating',
               'currentStreak', 'weeklyReps', 'weeklyDelta',
               'leagueTier', 'updatedAt'
             ])
             && data.accountID == accountID
             && validDisplayName(data.displayName)
             && data.rating is int
             && data.rating >= 100
             && data.rating <= 1000
             && data.peakRating is int
             && data.peakRating >= data.rating
             && data.peakRating <= 1000
             && data.currentStreak is int
             && data.currentStreak >= 0
             && data.currentStreak <= 10000
             && data.weeklyReps is int
             && data.weeklyReps >= 0
             && data.weeklyReps <= 10000
             && data.weeklyDelta is int
             && data.weeklyDelta >= -10000
             && data.weeklyDelta <= 10000
             && (data.leagueTier == null
                 || data.leagueTier in [
                   'bronze', 'silver', 'gold', 'platinum', 'diamond'
                 ])
             && data.updatedAt is timestamp;
    }

    function updatesOnlyDisplayName(accountID) {
      return isWritableOwner(accountID)
             && validPublicProfile(request.resource.data, accountID)
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['displayName']);
    }

    function challengeParticipant(challengeID) {
      let challenge = get(
        /databases/$(database)/documents/challenges/$(challengeID)
      );
      return isAuthenticated()
             && challenge.data.participantIDs is list
             && request.auth.uid in challenge.data.participantIDs;
    }

    match /_serverRateLimits/{document=**} {
      allow read, write: if false;
    }

    match /_socialState/{document=**} {
      allow read, write: if false;
    }

    match /_socialReferences/{document=**} {
      allow read, write: if false;
    }

    match /_socialReferenceCutover/{document=**} {
      allow read, write: if false;
    }

    match /_accountDeletionState/{document=**} {
      allow read, write: if false;
    }

    match /_verifiedSessionEvidence/{document=**} {
      allow read, write: if false;
    }

    match /_socialFriendLinks/{document=**} {
      allow read, write: if false;
    }

    // The iOS sync owner has exactly five private paths. Explicit matches stop
    // an authenticated client from manufacturing an unbounded nested subtree
    // that later makes account deletion expensive or incomplete.
    match /users/{accountID} {
      allow get: if isOwner(accountID);
      allow list, delete: if false;
      allow create, update: if isWritableOwner(accountID)
                            && validPrivateUserRoot(
                              request.resource.data,
                              accountID
                            );

      match /profile/{profileID} {
        allow read: if isOwner(accountID) && profileID == 'main';
        allow create, update: if isWritableOwner(accountID)
                              && profileID == 'main'
                              && validPrivateProfile(request.resource.data);
        allow delete: if false;
      }

      match /progress/{progressID} {
        allow read: if isOwner(accountID) && progressID == 'main';
        allow create, update: if isWritableOwner(accountID)
                              && progressID == 'main'
                              && validPrivateProgress(request.resource.data);
        allow delete: if false;
      }

      match /sessions/{sessionID} {
        allow read: if isOwner(accountID);
        allow create, update: if isWritableOwner(accountID)
                              && validPrivateSession(
                                request.resource.data,
                                sessionID
                              );
        allow delete: if false;
      }

      match /recommendations/{recommendationID} {
        allow read: if isOwner(accountID) && recommendationID == 'state';
        // Recommendation evidence is a versioned whole-state ledger. Only the
        // authenticated App Check callable may advance its server revision;
        // accepting legacy direct writes would bypass compare-and-swap.
        allow create, update: if false;
        allow delete: if false;
      }
    }

    match /profiles_public/{accountID} {
      allow get, list, create, delete: if false;
      allow update: if updatesOnlyDisplayName(accountID);
    }

    match /leagues/{bucket}/members/{accountID} {
      allow get, list, create, delete: if false;
      allow update: if updatesOnlyDisplayName(accountID);
    }

    match /challenges/{challengeID} {
      allow get: if isAuthenticated()
                 && resource.data.participantIDs is list
                 && request.auth.uid in resource.data.participantIDs;
      allow list: if isAuthenticated()
                  && request.query.limit != null
                  && request.query.limit <= 50
                  && resource.data.participantIDs is list
                  && request.auth.uid in resource.data.participantIDs;
      allow create, update, delete: if false;

      match /submissions/{accountID} {
        allow get: if isOwner(accountID)
                   && challengeParticipant(challengeID);
        allow list, create, update, delete: if false;
      }

      match /combined/{resultID} {
        allow get: if resultID == 'result'
                   && challengeParticipant(challengeID);
        allow list, create, update, delete: if false;
      }
    }
  }
}
