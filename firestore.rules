rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Assumed public data model:
    // - profiles_public/{uid} and leagues/{bucket}/members/{uid} contain only
    //   bounded display data plus server-authored rating/streak/repetition
    //   aggregates and a server timestamp.
    // - challenges/{uuid} contains two immutable Firebase UIDs, bounded names
    //   and prompt, server timestamps, and optional server-derived results.
    // - _serverRateLimits and _socialState are callable-only state. The Admin
    //   SDK bypasses these rules; no client may inspect or mutate them.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(accountID) {
      return isAuthenticated() && request.auth.uid == accountID;
    }

    function validDisplayName(value) {
      return value is string && value.size() > 0 && value.size() <= 60;
    }

    function validPublicProfile(data, accountID) {
      return data.keys().hasOnly([
               'accountID', 'displayName',
               'rating', 'peakRating',
               'currentStreak', 'weeklyReps', 'weeklyDelta',
               'leagueTier', 'updatedAt'
             ])
             && data.accountID == accountID
             && validDisplayName(data.displayName)
             && data.rating is int
             && data.rating >= 100
             && data.rating <= 1000
             && data.peakRating is int
             && data.peakRating >= data.rating
             && data.peakRating <= 1000
             && data.currentStreak is int
             && data.currentStreak >= 0
             && data.currentStreak <= 10000
             && data.weeklyReps is int
             && data.weeklyReps >= 0
             && data.weeklyReps <= 10000
             && data.weeklyDelta is int
             && data.weeklyDelta >= -10000
             && data.weeklyDelta <= 10000
             && (data.leagueTier == null
                 || data.leagueTier in [
                   'bronze', 'silver', 'gold', 'platinum', 'diamond'
                 ])
             && data.updatedAt is timestamp;
    }

    function updatesOnlyDisplayName(accountID) {
      return isOwner(accountID)
             && validPublicProfile(request.resource.data, accountID)
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['displayName']);
    }

    match /_serverRateLimits/{accountID} {
      allow read, write: if false;
    }

    match /_socialState/{document=**} {
      allow read, write: if false;
    }

    // Private account data remains owner-scoped. The social callables read a
    // completed session from this subtree but never take its score from input.
    match /users/{accountID}/{document=**} {
      allow read, write: if isOwner(accountID);
    }

    match /profiles_public/{accountID} {
      allow read: if isAuthenticated();
      allow create, delete: if false;
      allow update: if updatesOnlyDisplayName(accountID);
    }

    match /leagues/{bucket}/members/{accountID} {
      allow read: if isAuthenticated();
      allow create, delete: if false;
      allow update: if updatesOnlyDisplayName(accountID);
    }

    match /challenges/{challengeID} {
      allow read: if isAuthenticated()
                  && resource.data.participantIDs is list
                  && request.auth.uid in resource.data.participantIDs;
      allow create, update, delete: if false;
    }
  }
}
