rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Assumed social data model:
    // - profiles_public/{uid}: bounded display name plus server-authored
    //   competitive aggregates. Callable reads only; clients cannot get/list.
    // - leagues/{bucket}/members/{uid}: the same non-PII aggregate shape,
    //   callable reads only; clients cannot get/list.
    // - challenges/{uuid}: immutable participant metadata and prompt only.
    // - challenges/{uuid}/submissions/{uid}: that participant's private result.
    // - challenges/{uuid}/combined/result: materialized only after both private
    //   submissions exist; both participants may then read the combined result.
    // - underscore-prefixed social collections: callable/runtime-only evidence,
    //   replay, rate-limit, relationship, cutover, tombstone, and exact-
    //   deletion reference state.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(accountID) {
      return isAuthenticated() && request.auth.uid == accountID;
    }

    function deletionPending(accountID) {
      return exists(
        /databases/$(database)/documents/_accountDeletionState/$(accountID)
      );
    }

    function isWritableOwner(accountID) {
      return isOwner(accountID) && !deletionPending(accountID);
    }

    function validDisplayName(value) {
      return value is string && value.size() > 0 && value.size() <= 60;
    }

    function validPublicProfile(data, accountID) {
      return data.keys().hasOnly([
               'accountID', 'displayName',
               'rating', 'peakRating',
               'currentStreak', 'weeklyReps', 'weeklyDelta',
               'leagueTier', 'updatedAt'
             ])
             && data.accountID == accountID
             && validDisplayName(data.displayName)
             && data.rating is int
             && data.rating >= 100
             && data.rating <= 1000
             && data.peakRating is int
             && data.peakRating >= data.rating
             && data.peakRating <= 1000
             && data.currentStreak is int
             && data.currentStreak >= 0
             && data.currentStreak <= 10000
             && data.weeklyReps is int
             && data.weeklyReps >= 0
             && data.weeklyReps <= 10000
             && data.weeklyDelta is int
             && data.weeklyDelta >= -10000
             && data.weeklyDelta <= 10000
             && (data.leagueTier == null
                 || data.leagueTier in [
                   'bronze', 'silver', 'gold', 'platinum', 'diamond'
                 ])
             && data.updatedAt is timestamp;
    }

    function updatesOnlyDisplayName(accountID) {
      return isWritableOwner(accountID)
             && validPublicProfile(request.resource.data, accountID)
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['displayName']);
    }

    function challengeParticipant(challengeID) {
      let challenge = get(
        /databases/$(database)/documents/challenges/$(challengeID)
      );
      return isAuthenticated()
             && challenge.data.participantIDs is list
             && request.auth.uid in challenge.data.participantIDs;
    }

    match /_serverRateLimits/{document=**} {
      allow read, write: if false;
    }

    match /_socialState/{document=**} {
      allow read, write: if false;
    }

    match /_socialReferences/{document=**} {
      allow read, write: if false;
    }

    match /_socialReferenceCutover/{document=**} {
      allow read, write: if false;
    }

    match /_accountDeletionState/{document=**} {
      allow read, write: if false;
    }

    match /_verifiedSessionEvidence/{document=**} {
      allow read, write: if false;
    }

    match /_socialFriendLinks/{document=**} {
      allow read, write: if false;
    }

    // Existing private account ownership remains unchanged in this slice.
    // Per-path user-subtree schemas are a separate hardening change because
    // profile, progress, session, and recommendation documents differ.
    match /users/{accountID}/{document=**} {
      allow read: if isOwner(accountID);
      allow write: if isWritableOwner(accountID);
    }

    match /profiles_public/{accountID} {
      allow get, list, create, delete: if false;
      allow update: if updatesOnlyDisplayName(accountID);
    }

    match /leagues/{bucket}/members/{accountID} {
      allow get, list, create, delete: if false;
      allow update: if updatesOnlyDisplayName(accountID);
    }

    match /challenges/{challengeID} {
      allow get: if isAuthenticated()
                 && resource.data.participantIDs is list
                 && request.auth.uid in resource.data.participantIDs;
      allow list: if isAuthenticated()
                  && request.query.limit != null
                  && request.query.limit <= 50
                  && resource.data.participantIDs is list
                  && request.auth.uid in resource.data.participantIDs;
      allow create, update, delete: if false;

      match /submissions/{accountID} {
        allow get: if isOwner(accountID)
                   && challengeParticipant(challengeID);
        allow list, create, update, delete: if false;
      }

      match /combined/{resultID} {
        allow get: if resultID == 'result'
                   && challengeParticipant(challengeID);
        allow list, create, update, delete: if false;
      }
    }
  }
}
