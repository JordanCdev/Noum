<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Replace with your Cognito Identity Pool ID -->
    <key>COGNITO_IDENTITY_POOL_ID</key>
    <string>YOUR_POOL_ID</string>
    <!-- AWS Region (defaults to eu-west-2) -->
    <key>AWS_REGION</key>
    <string>eu-west-2</string>
</dict>
</plist>
