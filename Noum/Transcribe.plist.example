<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
     Local development only.
     Copy this file to Transcribe.plist and keep the real file out of git.
     These values are bundled into the app, so do not ship long-lived AWS secrets
     in a production or public build.
    -->
    <key>AWS_ACCESS_KEY_ID</key>
    <string>YOUR_ACCESS_KEY</string>
    <key>AWS_SECRET_ACCESS_KEY</key>
    <string>YOUR_SECRET_KEY</string>
    <!-- Optional session token for temporary credentials -->
    <key>AWS_SESSION_TOKEN</key>
    <string></string>
    <!-- AWS Region (defaults to eu-west-2) -->
    <key>AWS_REGION</key>
    <string>eu-west-2</string>
</dict>
</plist>
