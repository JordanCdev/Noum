{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "test": "npm run build && node --test lib/competitiveObservation.test.js lib/friendshipAuthority.test.js lib/index.test.js lib/recommendationState.test.js lib/releaseSecurity.test.js lib/socialAuthority.test.js && node --test ../scripts/release-backend-deploy.test.mjs",
    "test:emulator": "node --test lib/emulator.integration.test.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "node ../scripts/release-backend-deploy.mjs",
    "deploy:coach-v2": "node ../scripts/deploy-coach-v2.mjs",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "^2.11.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "typescript": "^5.7.3"
  },
  "private": true
}
